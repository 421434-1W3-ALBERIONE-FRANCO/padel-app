# Copiar a .env y completar. El .env NUNCA se commitea: el repositorio es público.
# Para generar secretos:  openssl rand -base64 48

# --- Puerto donde nginx publica el sitio. En producción, delante va un proxy con TLS.
HTTP_PORT=8081

# --- URL pública del sitio: back_urls de MercadoPago, enlaces de los emails y origen CORS permitido.
FRONTEND_URL=https://padel.example.com

# --- Base de datos
POSTGRES_DB=padeldb
POSTGRES_USER=padel
POSTGRES_PASSWORD=CAMBIAR-generar-con-openssl

# --- Redis (límites por IP y revocación de sesiones)
REDIS_PASSWORD=CAMBIAR-generar-con-openssl

# --- JWT: al menos 32 caracteres aleatorios. Cambiarlo cierra todas las sesiones.
JWT_SECRET=CAMBIAR-generar-con-openssl-rand-base64-48
# Vigencia del token en milisegundos (4 horas).
JWT_EXPIRATION=14400000

# --- MercadoPago
MP_ACCESS_TOKEN=CAMBIAR
# Secreto de firma de los webhooks. Sin él los avisos se rechazan y los pagos online no se confirman.
MP_WEBHOOK_SECRET=
# Antigüedad máxima aceptada del aviso, en segundos (0 = no se controla).
MP_WEBHOOK_TOLERANCIA_SEGUNDOS=0
# Terminal Point del mostrador (opcional).
MP_POINT_DEVICE_ID=

# --- Email (SMTP). Con la verificación de email activa, sin SMTP los jugadores nuevos no pueden entrar.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
AUTH_VERIFICACION_EMAIL=true

# --- WhatsApp por Twilio (opcional: vacío = no se envían)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Redes desde las que el staff puede fichar (CIDR separados por coma). Vacío = sin restricción.
# Ojo: es la IP con la que llega el pedido; detrás de NAT es la IP pública del club.
CONTROL_HORARIO_REDES=

# --- Zona horaria del club
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Backups diarios de la base en ./backups
BACKUP_RETENTION_DAYS=14
